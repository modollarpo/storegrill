# Copy to .env and fill in values. Never commit .env.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/storegrill
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/storegrill_test
# Set to 0 when using prisma migrate deploy instead of db push on boot.
AUTO_SCHEMA_SYNC=0

# --- App ---------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Azure OpenAI (chat, embeddings, dall-e) --------------------------------
# Direct (non-Azure) mode: only OPENAI_API_KEY is required.
# Azure mode: set AZURE_OPENAI_ENDPOINT and use OPENAI_API_KEY as the Azure key.
OPENAI_API_KEY=
AI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_DALLE_DEPLOYMENT=dall-e-3
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small
# openai | azure
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_MERCHANDISING_ENABLED=false

# --- Azure AI Search ----------------------------------------------------------
# Optional. When set, /api/v1/search uses hybrid (vector + keyword) search and
# product create/update/delete keep the index in sync. Falls back to SQL when unset.
AZURE_SEARCH_ENDPOINT=https://YOUR_SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=storegrill-products-v1
AZURE_SEARCH_API_VERSION=2023-11-01
AZURE_SEARCH_EMBEDDING_DIMENSIONS=1536

# --- Reindex queue (Azure Queue Storage) ---------------------------------------
# Optional. When set, POST /api/v1/search/reindex enqueues a task consumed by a
# background poller (30s) instead of reindexing inline. Queue is purged on startup.
AZURE_QUEUE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net
AZURE_QUEUE_NAME=search-reindex

# --- Email (Azure Communication Services) --------------------------------------
# console logs messages; acs sends through Azure Communication Services Email.
MAIL_PROVIDER=acs
ACS_CONNECTION_STRING=endpoint=https://YOUR_RESOURCE.communication.azure.com/;accesskey=PRIMARY_OR_SECONDARY_KEY
MAIL_FROM=DoNotReply@storegrill.net