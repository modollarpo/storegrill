generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String?
  name             String
  role             String    @default("CUSTOMER")
  avatar           String?
  phone            String?
  emailVerified    DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  tokenVersion     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customerProfile CustomerProfile?
  vendorProfile   VendorProfile?
  cart            Cart?
  orders          Order[]
  reviews         Review[]
  notifications   Notification[]
  oauthAccounts   OAuthAccount[]
  emailTokens     EmailToken[]
  wishlistItems   WishlistItem[]
  blogPosts       BlogPost[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model CustomerProfile {
  id                 String @id @default(cuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredRegionKey String @default("US")
  defaultCurrency    String @default("USD")
  defaultLanguage    String @default("en")
  shippingAddresses  String @default("[]")
}

model VendorProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName              String
  slug                   String    @unique
  description            String?
  logo                   String?
  banner                 String?
  returnPolicy           String?
  shippingPolicy         String?
  supportEmail           String?
  supportPhone           String?
  businessLegalName      String?
  businessType           String?
  registrationNumber     String?
  taxId                  String?
  countryOfRegistration  String?
  website                String?
  warehouseRegionKey     String    @default("UK")
  plannedCategories      String?
  documents              String?
  onboardingStep         Int       @default(0)
  submittedAt            DateTime?
  reviewedBy             String?
  reviewedAt             DateTime?
  reviewNotes            String?
  kycStatus              String    @default("PENDING")
  kycData                String?
  payoutMethod           String?
  revenueSharePct        Float     @default(12.0)
  fixedFeeMinorUnits     Int       @default(30)
  status                 String    @default("PENDING")
  isHouseVendor          Boolean   @default(false)
  autoPublishImports     Boolean   @default(false)
  shippingMode           String    @default("REGION")
  shippingFlatMinorUnits Int?
  shippingCountries      String?
  rating                 Float     @default(0)
  reviewCount            Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  products       Product[]
  storefronts    Storefront[]
  deals          Deal[]
  payouts        Payout[]
  importJobs     ImportJob[]
  orderItems     OrderItem[]
  payoutAccount  VendorPayoutAccount?
  ImportSchedule ImportSchedule[]
}

model VendorPayoutAccount {
  id           String        @id @default(cuid())
  vendorId     String        @unique
  vendor       VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  method       String
  bankName     String?
  accountLast4 String?
  paypalEmail  String?
  country      String?
  currencyCode String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Storefront {
  id          String        @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  regionKey   String
  slug        String        @unique
  name        String
  description String?
  banner      String?
  enabled     Boolean       @default(true)

  @@unique([vendorId, regionKey])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  image    String?
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  logo     String?
  products Product[]
}

model Product {
  id                  String        @id @default(cuid())
  vendorId            String
  vendor              VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name                String
  slug                String        @unique
  description         String
  shortDescription    String?
  sku                 String
  barcode             String?
  categoryId          String
  category            Category      @relation(fields: [categoryId], references: [id])
  brandId             String?
  brand               Brand?        @relation(fields: [brandId], references: [id])
  images              String        @default("[]")
  thumbnail           String?
  basePriceMinorUnits Int
  currencyCode        String        @default("USD")
  weightGrams         Int?
  dimensions          String?
  status              String        @default("DRAFT")
  rating              Float         @default(0)
  reviewCount         Int           @default(0)
  totalSales          Int           @default(0)
  tags                String        @default("[]")
  attributes          String        @default("[]")
  sourceUrl           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  variants         ProductVariant[]
  regionPrices     ProductRegionPrice[]
  inventory        InventoryLedger[]
  reviews          Review[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  dealVariants     DealVariant[]
  importJobResults ImportJobResult[]
  wishlistItems    WishlistItem[]
  compatibleWith   Product[]        @relation("ProductCompanions")
  relatedTo        Product[]        @relation("ProductCompanions")

  @@unique([vendorId, sku])
}

model ProductVariant {
  id                  String  @id @default(cuid())
  productId           String
  product             Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                String
  sku                 String  @unique
  barcode             String?
  basePriceMinorUnits Int
  currencyCode        String  @default("USD")
  images              String  @default("[]")
  attributes          String  @default("[]")
  stock               Int     @default(0)
  weightGrams         Int?

  inventory    InventoryLedger[]
  dealVariants DealVariant[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
}

model ProductRegionPrice {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  regionKey       String
  region          Region  @relation(fields: [regionKey], references: [key])
  priceMinorUnits Int
  currencyCode    String

  @@unique([productId, regionKey])
}

model Warehouse {
  id        String  @id @default(cuid())
  name      String
  regionKey String
  region    Region  @relation(fields: [regionKey], references: [key])
  address   String?
  active    Boolean @default(true)

  inventory InventoryLedger[]
}

model InventoryLedger {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  quantity    Int
  reason      String
  createdAt   DateTime        @default(now())
}

model Region {
  key             String   @id
  name            String
  languages       String
  defaultLanguage String
  currencies      String
  defaultCurrency String
  defaultTimezone String
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products      ProductRegionPrice[]
  taxRules      TaxRule[]
  shippingZones ShippingZone[]
  warehouses    Warehouse[]
  deals         Deal[]
}

model TaxRule {
  id         String   @id @default(cuid())
  regionKey  String
  region     Region   @relation(fields: [regionKey], references: [key])
  name       String
  rate       Float
  type       String
  categoryId String?
  minAmount  Int?
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model ShippingZone {
  id                              String   @id @default(cuid())
  regionKey                       String
  region                          Region   @relation(fields: [regionKey], references: [key])
  name                            String
  countries                       String
  baseRateMinorUnits              Int
  currencyCode                    String
  perKgRateMinorUnits             Int?
  freeShippingThresholdMinorUnits Int?
  estimatedDaysMin                Int?
  estimatedDaysMax                Int?
  carriers                        String
  enabled                         Boolean  @default(true)
  createdAt                       DateTime @default(now())

  shipments Shipment[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  addedAt   DateTime        @default(now())
}

model Order {
  id                 String   @id @default(cuid())
  orderNumber        String   @unique
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  status             String   @default("PENDING")
  regionKey          String
  currencyCode       String
  subtotalMinorUnits Int
  taxMinorUnits      Int
  shippingMinorUnits Int
  discountMinorUnits Int      @default(0)
  totalMinorUnits    Int
  shippingAddress    String
  billingAddress     String?
  paymentMethod      String
  paymentId          String?
  paymentStatus      String   @default("PENDING")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items     OrderItem[]
  shipments Shipment[]
  payments  Payment[]
  refunds   Refund[]
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product         @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id])
  vendorId            String
  vendor              VendorProfile   @relation(fields: [vendorId], references: [id])
  name                String
  sku                 String
  image               String?
  quantity            Int
  unitPriceMinorUnits Int
  totalMinorUnits     Int
  taxMinorUnits       Int             @default(0)
}

model Shipment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  shippingZoneId    String?
  shippingZone      ShippingZone? @relation(fields: [shippingZoneId], references: [id])
  carrier           String
  trackingNumber    String?
  status            String        @default("PENDING")
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  shippingAddress   String
  costMinorUnits    Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  events ShipmentEvent[]
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  status      String
  location    String?
  description String?
  timestamp   DateTime @default(now())
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id])
  method            String
  providerPaymentId String?
  amountMinorUnits  Int
  currencyCode      String
  status            String
  metadata          String?
  createdAt         DateTime @default(now())
}

model Refund {
  id               String    @id @default(cuid())
  orderId          String
  order            Order     @relation(fields: [orderId], references: [id])
  amountMinorUnits Int
  currencyCode     String
  reason           String
  status           String    @default("PENDING")
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
}

model Deal {
  id                 String         @id @default(cuid())
  name               String
  slug               String         @unique
  description        String?
  type               String
  value              Float
  minOrderAmount     Int?
  maxDiscount        Int?
  maxUsesPerCustomer Int?
  totalUses          Int?
  usedCount          Int            @default(0)
  startsAt           DateTime
  endsAt             DateTime
  enabled            Boolean        @default(true)
  regionKey          String?
  region             Region?        @relation(fields: [regionKey], references: [key])
  vendorId           String?
  vendor             VendorProfile? @relation(fields: [vendorId], references: [id])
  categoryIds        String         @default("[]")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  variants DealVariant[]
  coupons  Coupon[]
}

model DealVariant {
  id        String          @id @default(cuid())
  dealId    String
  deal      Deal            @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}

model Coupon {
  id        String    @id @default(cuid())
  dealId    String
  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  code      String    @unique
  maxUses   Int?
  usedCount Int       @default(0)
  expiresAt DateTime?
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  rating      Int
  title       String?
  body        String?
  images      String   @default("[]")
  verified    Boolean  @default(false)
  vendorReply String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, productId])
}

model Payout {
  id               String        @id @default(cuid())
  vendorId         String
  vendor           VendorProfile @relation(fields: [vendorId], references: [id])
  amountMinorUnits Int
  currencyCode     String
  status           String        @default("PENDING")
  period           String
  processedAt      DateTime?
  createdAt        DateTime      @default(now())

  lines PayoutLine[]
}

model PayoutLine {
  id          String @id @default(cuid())
  payoutId    String
  payout      Payout @relation(fields: [payoutId], references: [id])
  orderItemId String
  amount      Int
  commission  Int
  fixedFee    Int    @default(30)
}

model ImportJob {
  id            String        @id @default(cuid())
  vendorId      String
  vendor        VendorProfile @relation(fields: [vendorId], references: [id])
  type          String
  source        String
  status        String        @default("PENDING")
  mode          String        @default("APPLY")
  phase         String?
  processedRows Int           @default(0)
  totalRows     Int           @default(0)
  successRows   Int           @default(0)
  errorRows     Int           @default(0)
  errors        String        @default("[]")
  scheduleId    String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())

  results ImportJobResult[]
}

model ImportSchedule {
  id          String        @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id])
  name        String
  url         String
  format      String        @default("csv")
  cadenceCron String        @default("0 3 * * *")
  enabled     Boolean       @default(true)
  etag        String?
  lastRunAt   DateTime?
  lastStatus  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ImportJobResult {
  id        String    @id @default(cuid())
  jobId     String
  job       ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?  @relation(fields: [productId], references: [id])
  rowNumber Int
  status    String
  message   String?
  data      String?
  createdAt DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  ip        String?
  createdAt DateTime @default(now())
}

model SearchSynonym {
  id        String  @id @default(cuid())
  term      String
  synonyms  String
  regionKey String?
}

model TranslationCache {
  id             String   @id @default(cuid())
  hash           String   @unique
  sourceLang     String
  targetLang     String
  sourceText     String
  translatedText String
  provider       String   @default("libretranslate")
  createdAt      DateTime @default(now())

  @@index([sourceLang, targetLang])
}

model NewsletterSubscriber {
  id              String    @id @default(cuid())
  email           String    @unique
  regionKey       String?
  verified        Boolean   @default(false)
  unsubscribedAt  DateTime?
  createdAt       DateTime  @default(now())
}

model Banner {
  id         String   @id @default(cuid())
  type       String   @default("hero") // hero, editorial, promo
  imageUrl   String
  title      String?
  subtitle   String?
  ctaLabel   String?
  ctaHref    String?
  bgColor    String?
  regionKeys String   @default("[]") // JSON array of regions, empty means all
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  posts     BlogPost[]
}

model BlogTag {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now())
  posts     BlogPostTag[]
}

model BlogPost {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String?
  body            String        // Markdown/HTML content
  coverImage      String?
  status          String        @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  featuredAt      DateTime?
  publishedAt     DateTime?
  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  readTimeMinutes Int           @default(0)
  viewCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tags            BlogPostTag[]

  @@index([status, publishedAt])
  @@index([slug])
  @@index([categoryId])
}

model BlogPostTag {
  postId    String
  tagId     String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag       BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model ContentPage {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  body       String   // Markdown/HTML content
  status     String   @default("DRAFT") // DRAFT | PUBLISHED
  regionKey  String?
  publishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([regionKey])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON-encoded value
  group     String   @default("general")
  updatedAt DateTime @updatedAt
}
